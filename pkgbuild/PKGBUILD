pkgname=sipsearch
pkgver=0.1.0
pkgrel=1
pkgdesc='Search the decentralized SIP-01 web index from the desktop'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'xdg-desktop-portal')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/sipsearch "$pkgdir/usr/bin/sipsearch"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/sipsearch.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/sipsearch.svg"
  install -Dm644 "$startdir/sipsearch.desktop" "$pkgdir/usr/share/applications/sipsearch.desktop"
}
